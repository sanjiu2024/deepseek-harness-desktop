# One style, enforced by the editor instead of by review.
#
# The point is not preference. `rustfmt` and the TypeScript formatter both make decisions the
# editor can quietly contradict: tabs versus spaces, trailing whitespace, a final newline. Without
# this file, a machine with the wrong defaults produces a diff full of whitespace and a `verify`
# failure that has nothing to do with the change.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4
# Generated by rustfmt; matching it here means an editor never fights it.
max_line_length = 100

[*.md]
# Two trailing spaces are a hard line break in Markdown; stripping them changes rendering.
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[Cargo.lock]
# Machine-owned: never reformat.
insert_final_newline = false
